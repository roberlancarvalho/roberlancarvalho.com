# rename this file to .env / .env.local and supply the real values below
# also make sure they are available to the build tool (e.g. Vercel)
#
# PENDENTE = valor real ainda não fornecido. Nunca preencha com um valor de
# exemplo/fictício — deixe PENDENTE até o usuário fornecer o dado real.

# Algolia (search) — kept per user decision
NEXT_PUBLIC_ALGOLIA_APP_ID=PENDENTE
NEXT_PUBLIC_ALGOLIA_SEARCH_ONLY_KEY=PENDENTE
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=PENDENTE
ALGOLIA_ADMIN_KEY=PENDENTE

# Google AdSense — kept per user decision
NEXT_PUBLIC_ADSENSE_CLIENT=PENDENTE

# Analytics — single implementation, replaces the old triplicated/broken GA.
# Both are production-only and inert without a real value.
NEXT_PUBLIC_GA_MEASUREMENT_ID=PENDENTE
NEXT_PUBLIC_CLARITY_PROJECT_ID=PENDENTE

# Sentry — project must be created by the user (not the Tech North DSN).
SENTRY_DSN=PENDENTE
NEXT_PUBLIC_SENTRY_DSN=PENDENTE

# Contact form (Resend) — server-side only, never exposed to the client.
RESEND_API_KEY=PENDENTE
CONTACT_TO_EMAIL=PENDENTE

# TinaCMS — optional, only required for the hosted admin panel at TinaCloud.
# `tinacms dev` works fully offline against the filesystem without these.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
